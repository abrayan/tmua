  "knowledgePattern": "Model the largest cylinder at each height before optimising",
  "hints": [
    {
      "title": "Use a vertical cross-section",
      "body": "<p>Compare the small pyramid above the cylinder with the whole pyramid. Relate the side length of a horizontal section to its height.</p>",
      "recap": "Corresponding sides of similar triangles have one common scale factor; a suitable cross-section reveals that ratio.",
      "pitfall": "The available radius is limited by the upper face, where the surrounding square is smaller.",
      "pause": "Express the largest feasible cylinder radius in terms of its height.",
      "recall": [
        {
          "lessonId": "p1-extra-similar-triangles",
          "reminder": "Corresponding sides of similar triangles have one common scale factor; a suitable cross-section reveals that ratio."
        }
      ]
    },
    {
      "title": "Form one dimensionless objective",
      "body": "<p>Write both volumes, divide, and use the cylinder height as a fraction of the pyramid height to simplify the expression.</p>",
      "recap": "Cylinder volume uses circular base area times perpendicular height; identify the correct cross-section and feasible dimensions.",
      "pitfall": "A bound on radius is useful only if a complete cylinder can attain it.",
      "pause": "Derive a one-variable expression for the volume ratio and its allowed interval.",
      "recall": [
        {
          "lessonId": "p1-b4-l06",
          "reminder": "Cylinder volume uses circular base area times perpendicular height; identify the correct cross-section and feasible dimensions."
        }
      ]
    },
    {
      "title": "Check where the ratio turns",
      "body": "<p>Differentiate the resulting polynomial and test its derivative signs, also checking the interval boundaries.</p>",
      "recap": "A derivative changing from positive to negative gives a maximum; endpoint values must also be compared.",
      "pitfall": "A zero derivative alone is not enough to establish the greatest feasible value.",
      "pause": "Find the attaining height and evaluate its ratio.",
      "recall": [
        {
          "lessonId": "p1-b1-l19",
          "reminder": "A derivative changing from positive to negative gives a maximum; endpoint values must also be compared."
        }
      ]
