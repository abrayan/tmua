  "knowledgePattern": "Split both layers of a modulus before adding triangular areas",
  "hints": [
    {
      "title": "Find both kinds of corner",
      "body": "<p>Locate where the inner expression changes sign and where the expression inside the outer modulus is zero.</p>",
      "recap": "A modulus equals its input when nonnegative and the negative of its input when negative.",
      "pitfall": "An outer modulus does not remove the need to track the inner one.",
      "pause": "Split the integration interval wherever either layer changes formula.",
      "recall": [
        {
          "lessonId": "p1-extra-function-mapping",
          "reminder": "A modulus equals its input when nonnegative and the negative of its input when negative."
        }
      ]
    },
    {
      "title": "Use the straight pieces",
      "body": "<p>On each piece, remove the modulus signs with the correct choices, then use triangular areas or integrate the resulting line.</p>",
      "recap": "Split a modulus integral at formula changes and add the appropriate region contributions.",
      "pitfall": "The final right-hand interval has a different width from the central pieces.",
      "pause": "Calculate every piece and combine them.",
