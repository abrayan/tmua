  "hints": [
    {
      "title": "Recover the middle side",
      "body": "<p>Use the supplied area–inradius formula to find the perimeter, then represent the three AP sides symmetrically around their middle term.</p>",
      "recap": "For three terms of an AP, the middle term equals their average.",
      "pitfall": "Nonconstant sides require a nonzero common difference, and a triangle also needs strict side inequalities.",
      "pause": "Find the middle side and the feasible difference range.",
      "recall": [
