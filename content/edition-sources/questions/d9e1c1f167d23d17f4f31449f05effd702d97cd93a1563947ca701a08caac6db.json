  "knowledgePattern": "Turn a variable power into a quadratic in its logarithm",
  "hints": [
    {
      "title": "Bring the variable exponent down",
      "body": "<p>Apply a logarithm with the same base as the logarithm already in the equation.</p>",
      "recap": "A logarithm turns a positive power into its exponent multiplied by the logarithm of its base.",
      "pitfall": "The logarithm of a power is a product, not a sum.",
      "pause": "Write the resulting equation entirely in terms of the repeated logarithm.",
      "recall": [
        {
          "lessonId": "p1-b1-l06",
          "reminder": "A logarithm turns a positive power into its exponent multiplied by the logarithm of its base."
        }
      ]
    },
    {
      "title": "Name the repeated quantity",
      "body": "<p>Use one variable for the repeated logarithm and solve the resulting polynomial. Then undo the substitution.</p>",
      "recap": "A logarithmic substitution must be reversed before answering a question about the original inputs.",
      "pitfall": "A product of the new roots is not the product of the original x-values.",
      "pause": "Recover both admissible inputs and form the requested product.",
      "recall": [
