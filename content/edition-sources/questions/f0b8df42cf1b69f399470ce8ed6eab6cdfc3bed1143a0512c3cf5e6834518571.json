  "knowledgePattern": "Recognise a binomial row before filtering a geometric-series probability",
  "hints": [
    {
      "title": "Recognise a binomial expansion",
      "body": "<p>Compare the finite sum inside <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>a</mi><mi>n</mi></msub></mrow></math> with the expansion of <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mo stretchy=\"false\">&#x00028;</mo><mn>1</mn><mo>&#x0002B;</mo><mi>t</mi><msup><mo stretchy=\"false\">&#x00029;</mo><mi>n</mi></msup></mrow></math>. Choose <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>t</mi></mrow></math> so that each power and combination matches.</p>",
      "recap": "The binomial expansion uses <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mo minsize=\"2.047em\" maxsize=\"2.047em\">&#x00028;</mo><mfrac linethickness=\"0\"><mrow><mi>n</mi></mrow><mrow><mi>r</mi></mrow></mfrac><mo minsize=\"2.047em\" maxsize=\"2.047em\">&#x00029;</mo><msup><mi>t</mi><mi>r</mi></msup></mrow></math> when the other term is 1.",
      "pitfall": "The factor <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mn>2</mn><mi>k</mi><mo>&#x0002B;</mo><mn>1</mn></mrow></math> is outside the sum; keep it.",
      "pause": "Rewrite <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msub><mi>a</mi><mi>n</mi></msub></mrow></math> as one power multiplied by a constant.",
      "recall": [
