  "label": "TMUA 2023 · Paper 2 · Question 13",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2023 · Paper 2 · Question 13 — Identify the statement that implies exactly three of the four others.\">",
  "options": [
