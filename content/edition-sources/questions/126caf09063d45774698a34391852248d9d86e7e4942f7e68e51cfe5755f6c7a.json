  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" alt=\"JZ Mock E · Paper 1 · Question 12. Complete original question and options. Use Enlarge question to inspect.\" src=\"data:image/png;base64,\">",
