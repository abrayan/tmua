  "label": "TMUA 2021 · Paper 1 · Question 4",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2021 · Paper 1 · Question 4 — Find the minimum of 2^(2x)-2^(x+3)+4.\">",
  "options": [
