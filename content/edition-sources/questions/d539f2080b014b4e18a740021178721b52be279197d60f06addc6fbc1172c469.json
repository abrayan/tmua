  "correct": "B",
  "hints": [
    {
      "title": "Expose the quadratic",
      "body": "<p>Set <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>u</mi><mo>&#x0003D;</mo><msup><mn>2</mn><mrow><mi>x</mi></mrow></msup><mo>&#x0003E;</mo><mn>0</mn></mrow></math>. Then <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msup><mn>2</mn><mrow><mn>2</mn><mi>x</mi></mrow></msup><mo>&#x0003D;</mo><msup><mi>u</mi><mrow><mn>2</mn></mrow></msup></mrow></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msup><mn>2</mn><mrow><mi>x</mi><mo>&#x0002B;</mo><mn>3</mn></mrow></msup><mo>&#x0003D;</mo><mn>8</mn><mi>u</mi></mrow></math>.</p>",
      "recap": "A repeated exponential can be replaced by one positive variable.",
      "pitfall": "The <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mo>&#x0002B;</mo><mn>3</mn></mrow></math> in the exponent multiplies <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msup><mn>2</mn><mrow><mi>x</mi></mrow></msup></mrow></math> by 8.",
      "pause": "Rewrite the expression in u.",
      "recall": [
        {
          "lessonId": "p1-b1-l05",
          "reminder": "A repeated exponential can be replaced by one positive variable."
        }
      ]
    },
    {
      "title": "Complete the square and test the range",
      "body": "Rewrite the expression as a quadratic in the positive variable. Complete its square, keeping the correction term, and find where the square vanishes.",
      "recap": "A nonnegative square gives a lower bound, attained only if its zero is allowed.",
      "pitfall": "Check the square expansion instead of guessing the constant correction.",
      "pause": "Derive the completed form, test attainment and state the minimum output.",
      "recall": [
        {
          "lessonId": "p1-b1-l03",
          "reminder": "A nonnegative square gives a lower bound, attained only if its zero is allowed."
        }
      ]
