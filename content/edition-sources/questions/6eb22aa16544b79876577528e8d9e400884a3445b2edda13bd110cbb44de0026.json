  "hints": [
    {
      "title": "List every boundary",
      "body": "<p>Find the zeros of each factor inside the stated interval and mark every undefined tangent input.</p>",
      "recap": "Use the whole trigonometric input when locating zeros, periods and asymptotes.",
      "pitfall": "A phase shift and input scale must both be undone when solving for x.",
      "pause": "Place all zeros and exclusions in increasing order.",
