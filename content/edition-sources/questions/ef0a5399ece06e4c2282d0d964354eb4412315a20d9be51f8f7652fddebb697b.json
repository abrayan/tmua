  "knowledgePattern": "Solve a variable-limit modulus integral on both sides of its corner",
  "hints": [
    {
      "title": "Split at the modulus corner",
      "body": "<p>Find where the expression inside the modulus changes sign, and distinguish upper limits on either side of that point.</p>",
      "recap": "A modulus integral uses different formulas on different input intervals; the integral itself keeps signed contributions.",
      "pitfall": "Subtracting the constant can make the full integrand negative even though the modulus is nonnegative.",
      "pause": "Write the appropriate integral for each position of the upper limit.",
      "recall": [
        {
          "lessonId": "p1-b1-l21",
          "reminder": "A modulus integral uses different formulas on different input intervals; the integral itself keeps signed contributions."
        }
      ]
    },
    {
      "title": "Preserve the accumulated contribution",
      "body": "<p>When the upper limit goes past the corner, retain the integral already accumulated before adding the remaining piece.</p>",
      "recap": "Evaluate each polynomial antiderivative at its upper and lower endpoints.",
      "pitfall": "A boundary root obtained from both formulas is counted only once.",
      "pause": "Solve both equations, check their ranges and add the distinct positive values.",
