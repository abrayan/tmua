  "knowledgePattern": "Compare trapezium heights with the exact V-shaped area",
  "hints": [
    {
      "title": "Use the strip boundaries",
      "body": "<p>Write the function heights at the two endpoints and the shared interior boundary. Apply the trapezium weights.</p>",
      "recap": "Two trapezia use three heights; only the shared interior height is doubled.",
      "pitfall": "The interior height depends on the vertex location and needs its modulus.",
      "pause": "Express the estimate in terms of the parameter.",
      "recall": [
