  "label": "TMUA early specimen · Paper 1 · Question 9",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA early specimen · Paper 1 · Question 9 — Find quadratic constant from a prescribed gap between roots.\">",
  "options": [
