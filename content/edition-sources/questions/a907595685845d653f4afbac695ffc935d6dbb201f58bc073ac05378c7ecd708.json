    {
      "title": "Keep the tangent branches separate",
      "body": "Mark the tangent asymptote within the given interval. Solve its lower and upper bounds on each continuous branch.",
      "recap": "Tangent is increasing on each branch but is undefined at its vertical asymptotes.",
      "pitfall": "Do not join allowed intervals across a tangent pole.",
      "pause": "Find the tangent-allowed intervals on a number line.",
      "recall": [
        {
          "lessonId": "p1-b1-l15",
          "reminder": "Tangent has separate branches divided by its vertical asymptotes; check its domain before reading graph values."
