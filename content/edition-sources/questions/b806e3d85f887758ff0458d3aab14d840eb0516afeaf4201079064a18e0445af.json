  "label": "JZ Mock E · Paper 2 · Question 13",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"JZ Mock E · Paper 2 · Question 13: Recover a binomial exponent from consecutive coefficient ratios. Complete question and all answer choices.\">",
  "options": [
