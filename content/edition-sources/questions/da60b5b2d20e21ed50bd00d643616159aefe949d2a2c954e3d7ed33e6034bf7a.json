  "hints": [
    {
      "title": "Solve for the whole tangent input",
      "body": "<p>Treat the squared distance from the origin as one nonnegative variable. List all tangent levels compatible with that restriction.</p>",
      "recap": "A trigonometric equation has a family of branches, filtered by the domain of its complete input.",
      "pitfall": "The input is squared radius, not radius.",
