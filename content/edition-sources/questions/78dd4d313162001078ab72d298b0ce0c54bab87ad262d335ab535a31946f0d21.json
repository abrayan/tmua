  "hints": [
    {
      "title": "Build a prime-exponent table",
      "body": "<p>Factor the three numerical bases into primes. For each prime, add its numerator exponents and subtract its denominator exponent.</p>",
      "recap": "Multiplying equal bases adds exponents and division subtracts them, including when those exponents contain signed variables.",
      "pitfall": "Keep the brackets around each entire exponent being subtracted.",
      "pause": "Write the simplified product of distinct prime powers.",
