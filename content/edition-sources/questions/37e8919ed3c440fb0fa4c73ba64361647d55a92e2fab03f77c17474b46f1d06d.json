  "hints": [
    {
      "title": "Locate the corner relative to the interval",
      "body": "<p>Separate cases according to whether the corner of the modulus graph lies before, inside or after the integration interval.</p>",
      "recap": "Cases must cover the whole stated domain, with boundary values assigned to a valid case.",
      "pitfall": "The formula for area changes when the vertex leaves the interval.",
      "pause": "Write the appropriate area expression in every case.",
      "recall": [
