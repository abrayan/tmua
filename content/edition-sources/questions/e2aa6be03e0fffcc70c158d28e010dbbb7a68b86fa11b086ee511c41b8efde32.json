  "hints": [
    {
      "title": "Find where area changes sign",
      "body": "<p>Factor the cubic to find every x-axis crossing inside the limits.</p>",
      "recap": "Total geometric area adds positive region areas, so split whenever the curve crosses the axis.",
      "pitfall": "The signed integral over the whole symmetric interval is not the total area.",
      "pause": "Mark the crossings and the sign of each resulting piece.",
      "recall": [
        {
          "lessonId": "p1-b1-l21",
          "reminder": "Total geometric area adds positive region areas, so split whenever the curve crosses the axis."
        }
      ]
    },
    {
      "title": "Use the matching halves",
      "body": "<p>Compare the curve at x and −x. You can calculate the areas on one side and use reflection.</p>",
      "recap": "Integrate the polynomial powers and evaluate upper limit minus lower limit on each chosen piece.",
      "pitfall": "Reverse a negative signed contribution before adding geometric areas.",
      "pause": "Evaluate the distinct pieces and combine their positive areas.",
      "recall": [
