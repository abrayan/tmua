  "label": "TMUA early specimen · Paper 2 · Question 18",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA early specimen · Paper 2 · Question 18 — Maximise median of five numbers with fixed mean and range.\">",
  "options": [
    "A",
