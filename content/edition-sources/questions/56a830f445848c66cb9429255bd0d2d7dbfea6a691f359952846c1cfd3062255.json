  "label": "JZ Mock A · Paper 2 · Question 2",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"JZ Mock A · Paper 2 · Question 2: Expand a radical quotient into powers before differentiating. Complete question and all answer choices.\">",
