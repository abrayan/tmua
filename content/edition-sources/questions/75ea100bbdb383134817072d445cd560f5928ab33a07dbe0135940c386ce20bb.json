  "label": "TMUA 2020 · Paper 2 · Question 2",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2020 · Paper 2 · Question 2 — Find cos θ from tan θ=2 and a lower-half-plane angle.\">",
  "options": [
