  "hints": [
    {
      "title": "Find B’s chance in the first round",
      "body": "<p>Draw a probability tree for one round, stopping each branch at its first success. Locate the path where A fails and then B succeeds, and calculate its probability.</p>",
      "recap": "Multiply probabilities along a sequence of independent throws.",
      "pitfall": "C does not throw after B has already won.",
      "pause": "Write the probability that B wins on the first round.",
      "recall": [
