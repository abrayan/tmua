  "label": "TMUA 2019 · Paper 2 · Question 19",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2019 · Paper 2 · Question 19 — Simplify the sum of two nested radical expressions.\">",
