  "hints": [
    {
      "title": "Use the sine rule",
      "body": "<p>Sketch the given side and angle, using a ray and a distance arc to locate the possible third vertices. Write the sine rule using side <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>x</mi></mrow></math>, side 2 and the given angle. Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>&#x003B8;</mi></mrow></math> be the acute angle with the sine value you find.</p>",
      "recap": "The same sine value can belong to <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>&#x003B8;</mi></mrow></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><msup><mn>180</mn><mo>&#x02218;</mo></msup><mo>&#x02212;</mo><mi>&#x003B8;</mi></mrow></math>.",
      "pitfall": "When the two angles coincide, they do not give two different triangles.",
      "pause": "Write the two possible values of the angle opposite side <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><mrow><mi>x</mi></mrow></math>.",
      "recall": [
        {
          "lessonId": "p1-b1-l17",
