  "knowledgePattern": "Rationalise each summand to expose cancellation between neighbours",
  "hints": [
    {
      "title": "Use the conjugate",
      "body": "<p>Rationalise a typical denominator and simplify its product before working on the whole sum.</p>",
      "recap": "A conjugate turns a sum of surds into a difference of their squares.",
      "pitfall": "The term at the lower summation limit must also be valid.",
      "pause": "Rewrite one general summand.",
      "recall": [
        {
          "lessonId": "p1-b4-l01",
          "reminder": "A conjugate turns a sum of surds into a difference of their squares."
        }
      ]
    },
    {
      "title": "Write the endpoints explicitly",
      "body": "<p>Expand the first few and last few rewritten summands and look for terms with opposite signs.</p>",
      "recap": "Simplification can cancel equal additive terms after the expression has been expanded correctly.",
      "pitfall": "Do not lose a surviving boundary term.",
      "pause": "Identify the surviving terms and evaluate them.",
      "recall": [
