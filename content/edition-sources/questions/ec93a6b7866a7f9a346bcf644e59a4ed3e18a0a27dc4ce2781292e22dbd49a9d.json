  "knowledgePattern": "Solve both cosine branches, remove duplicates and sum an inclusive angle progression",
  "hints": [
    {
      "title": "Use one trigonometric function",
      "body": "<p>Rewrite the phase-shifted sine as a cosine, then give both angle relations that can produce equal cosine values.</p>",
      "recap": "The entire angle input must be tracked when comparing trigonometric graphs and exact phase shifts.",
      "pitfall": "Equal cosine values do not force equal angles.",
      "pause": "Solve both integer-indexed angle relations on the stated interval.",
