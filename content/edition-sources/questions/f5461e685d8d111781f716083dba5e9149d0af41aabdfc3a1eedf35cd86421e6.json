  "label": "TMUA 2020 · Paper 1 · Question 20",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2020 · Paper 1 · Question 20 — Count parameters a giving exactly two distinct roots of a factored cubic.\">",
  "options": [
