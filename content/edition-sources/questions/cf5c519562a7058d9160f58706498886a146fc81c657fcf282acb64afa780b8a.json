      ]
    },
    {
      "title": "Compare areas inside one rectangle",
      "body": "<p>Use the supplied reflection fact to place the graph and its inverse in the rectangle determined by their matching endpoints.</p>",
      "recap": "Geometric regions can be combined or subtracted when their boundaries and shared interval are identified.",
      "pitfall": "Work out which region lies below each inverse graph before combining their areas.",
      "pause": "Relate the inverse area to the given integral.",
      "recall": [
