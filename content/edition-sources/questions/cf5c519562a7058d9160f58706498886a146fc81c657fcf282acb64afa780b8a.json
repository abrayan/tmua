  "hints": [
    {
      "title": "Find the increasing inverse",
      "body": "<p>Solve the given function relation with input and output interchanged, respecting the nonnegative square root.</p>",
      "recap": "Logarithms undo positive-base exponential functions; inverse graphs interchange input and output coordinates.",
      "pitfall": "Squaring while finding an inverse needs the correct logarithm sign and domain.",
      "pause": "Write the inverse expression and find its relevant endpoint values.",
      "recall": [
