  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2018 · Paper 1 · Question 18 — Find the least positive a such that x=a reflects y=sin(2x-4pi/3) onto itself.\">",
