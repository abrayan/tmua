  "knowledgePattern": "Use one common power value and combine reciprocal exponents",
  "hints": [
    {
      "title": "Name the common positive value",
      "body": "<p>Give the three equal powers a common name, then take logarithms using one fixed valid base.</p>",
      "recap": "The power law moves an exponent in front of a logarithm, and product laws combine logarithms of positive factors.",
      "pitfall": "Retain the minus sign in the third exponent.",
      "pause": "Express each exponent in terms of the common logarithm.",
      "recall": [
        {
          "lessonId": "p1-b1-l06",
          "reminder": "The power law moves an exponent in front of a logarithm, and product laws combine logarithms of positive factors."
        }
      ]
    },
    {
      "title": "Rearrange for what is requested",
      "body": "<p>The question asks for reciprocals, so express each reciprocal with a common denominator before adding.</p>",
      "recap": "Index laws and logarithms connect equal positive powers without requiring the bases themselves to be equal.",
      "pitfall": "Check that the common denominator is nonzero before dividing.",
      "pause": "Combine the three reciprocal expressions and simplify the numerator.",
