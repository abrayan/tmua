  "label": "TMUA 2022 · Paper 1 · Question 13",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2022 · Paper 1 · Question 13 — Solve a rational algebraic constraint to find the least possible product of two real variables.\">",
  "options": [
    "A",
    "B",
