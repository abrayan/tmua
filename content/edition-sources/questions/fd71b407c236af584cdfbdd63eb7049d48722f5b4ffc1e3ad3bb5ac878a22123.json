  "label": "TMUA 2016 · Paper 2 · Question 3",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2016 · Paper 2 · Question 3 — Find the largest radian solution on [0,2π].\">",
