  "hints": [
    {
      "title": "Mark every zero",
      "body": "<p>Factor the difference of squares, then mark the zeros of all the factors on a number line.</p>",
      "recap": "Zeros divide the number line into intervals on which a polynomial’s sign can be tested.",
      "pitfall": "A product can be positive even when some factors are negative.",
      "pause": "Use the zeros to split the number line into intervals.",
      "recall": [
