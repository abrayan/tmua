  "label": "TMUA 2018 · Paper 1 · Question 6",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2018 · Paper 1 · Question 6 — Count roots of x sin(2x)=cos(2x) on [0,2pi].\">",
