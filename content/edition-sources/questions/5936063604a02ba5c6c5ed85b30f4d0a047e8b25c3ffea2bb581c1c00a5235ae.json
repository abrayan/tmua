  "knowledgePattern": "Intersect two rational sign charts while retaining their different endpoints",
  "hints": [
    {
      "title": "List zeros and exclusions",
      "body": "<p>Factor both numerators and denominators. Make a separate sign chart for each rational expression.</p>",
      "recap": "Numerator zeros can be included for a non-strict inequality, while original denominator zeros are always excluded.",
      "pitfall": "Multiplying by an unknown-sign denominator can reverse an inequality.",
      "pause": "Find each complete solution set before combining them.",
      "recall": [
        {
          "lessonId": "p1-b1-l04",
          "reminder": "Numerator zeros can be included for a non-strict inequality, while original denominator zeros are always excluded."
        }
      ]
    },
    {
      "title": "Keep only the overlap",
      "body": "<p>Intersect the two sets, checking every boundary against both original inequalities.</p>",
      "recap": "AND conditions require common intervals, with the correct strict or inclusive endpoints.",
      "pitfall": "Do not add lengths from intervals that satisfy only one condition.",
      "pause": "Measure the final permitted interval or intervals.",
      "recall": [
