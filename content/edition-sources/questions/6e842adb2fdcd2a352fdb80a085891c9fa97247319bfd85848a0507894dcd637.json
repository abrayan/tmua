  "knowledgePattern": "Use all three stationary heights to ensure four distinct quartic crossings",
  "hints": [
    {
      "title": "Find the stationary points before counting roots",
      "body": "<p>Differentiate and factor the derivative. Check separately any parameter value for which stationary points merge.</p>",
      "recap": "The polynomial power rule produces the derivative, whose factors locate stationary points.",
      "pitfall": "The order of parameter-dependent stationary points may change when the parameter changes sign.",
      "pause": "Determine their order and whether each is a maximum or minimum.",
      "recall": [
