  "source": "<a target=\"_blank\" rel=\"noopener\" href=\"https://uat-wp.s3.eu-west-2.amazonaws.com/wp-content/uploads/2024/05/07125102/TMUA-2016-paper-2.pdf#page=3\">TMUA 2016 · Paper 2 · Question 1</a> · <a target=\"_blank\" rel=\"noopener\" href=\"https://uat-wp.s3.eu-west-2.amazonaws.com/wp-content/uploads/2024/05/07125106/TMUA-2016-paper-2-worked-answers.pdf#page=4\">Official worked answer</a>",
  "options": [
