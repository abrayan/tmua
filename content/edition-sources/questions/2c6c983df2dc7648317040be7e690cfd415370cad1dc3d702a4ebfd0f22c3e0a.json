  "label": "TMUA 2018 · Paper 1 · Question 3",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2018 · Paper 1 · Question 3 — Find the smallest separation of the two given circles.\">",
  "options": [
    "A",
    "B",
    "C",
    "D",
