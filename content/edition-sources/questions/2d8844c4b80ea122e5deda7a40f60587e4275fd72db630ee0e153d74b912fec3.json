  "label": "TMUA 2020 · Paper 1 · Question 12",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2020 · Paper 1 · Question 12 — Count real solutions of 3 cos x=√x in radians.\">",
  "options": [
