  "label": "JZ Mock D · Paper 2 · Question 11",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"JZ Mock D · Paper 2 · Question 11: Count bounded integer allocations without distinguishing identical objects. Complete question and all answer choices.\">",
