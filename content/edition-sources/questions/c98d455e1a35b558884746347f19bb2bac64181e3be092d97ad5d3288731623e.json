  "label": "TMUA 2022 · Paper 1 · Question 1",
  "lead": "<img class=\"source-question\" tabindex=\"0\" role=\"button\" aria-label=\"Enlarge question\" src=\"data:image/png;base64,\" alt=\"TMUA 2022 · Paper 1 · Question 1 — Count real angles solving a quartic cosine equation on the closed interval [0,2π].\">",
  "options": [
